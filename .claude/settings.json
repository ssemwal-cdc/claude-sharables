{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "deny": [
      "mcp__Netsuite_MCP__ns_createRecord",
      "mcp__Netsuite_MCP__ns_updateRecord"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/refuse_shared_tree.sh\"",
            "timeout": 10,
            "statusMessage": "Checking the command against the shared-tree rules"
          }
        ]
      }
    ]
  }
}
